<Window x:Class="FlickyAshtray.Windows.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flicky Ashtray 桌宠"
        Width="220" Height="180"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="PetActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="HitSurface"
          Background="Transparent"
          MouseEnter="HitSurface_MouseEnter"
          MouseLeave="HitSurface_MouseLeave"
          MouseLeftButtonDown="HitSurface_MouseLeftButtonDown"
          MouseRightButtonUp="HitSurface_MouseRightButtonUp">
        <Viewbox Stretch="Fill">
            <Grid x:Name="BaseSurface" Width="220" Height="180">
                <Canvas x:Name="AshtraySurface" Width="220" Height="180">
                    <Image Width="250" Height="202"
                           Canvas.Left="-15" Canvas.Top="-11"
                           Source="pack://application:,,,/Assets/ashtray.png"
                           Stretch="Uniform" />
                    <Image x:Name="AshLayer"
                           Stretch="Uniform"
                           IsHitTestVisible="False" />
                    <Button x:Name="CigaretteButton"
                            Width="86" Height="70"
                            Canvas.Left="109" Canvas.Top="21"
                            Style="{StaticResource PetActionButton}"
                            ToolTip="点这支烟，记一根"
                            Click="CigaretteButton_Click">
                        <Image Width="80" Height="50"
                               Source="pack://application:,,,/Assets/cigarette.png"
                               Stretch="Uniform"
                               RenderTransformOrigin="0.27,0.31">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="CigaretteRotation" Angle="122" />
                                    <TranslateTransform x:Name="CigaretteTranslation" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Button>
                </Canvas>

                <Border x:Name="NoteSurface"
                        Width="206" Height="132"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" />
                    </Border.Effect>
                    <Grid Margin="18,14,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="戒烟日志"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock x:Name="NoteCountText"
                                       Margin="0,4,0,1"
                                       FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                                       FontSize="26"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="NoteDetailText"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock x:Name="NoteLastRecordText"
                                       Margin="0,4,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TertiaryTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="44" Height="44"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource PetActionButton}"
                                ToolTip="点一下，记一根"
                                Click="IgniterButton_Click">
                            <Grid Width="38" Height="38">
                                <Ellipse Fill="{DynamicResource RaisedSurfaceBrush}"
                                         Stroke="{DynamicResource BorderBrush}" />
                                <Ellipse Width="28" Height="28"
                                         Stroke="{DynamicResource TertiaryTextBrush}"
                                         Opacity="0.55" />
                                <Ellipse Width="19" Height="19"
                                         Stroke="#88906060" />
                                <Ellipse x:Name="IgniterEmber"
                                         Width="9" Height="9"
                                         Fill="{DynamicResource TertiaryTextBrush}"
                                         Opacity="0.35" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
