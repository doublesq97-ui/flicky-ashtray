<Window x:Class="FlickyAshtray.Windows.ResetHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重置历史记录"
        Width="480" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <StackPanel x:Name="ReasonStage">
            <TextBlock Text="重置历史记录" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="WarningText"
                       Margin="0,9,0,16"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock Text="为什么要重置？" FontWeight="SemiBold" />
            <TextBox x:Name="ReasonBox"
                     Margin="0,7,0,5"
                     Height="92"
                     Padding="8"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxLength="200"
                     TextChanged="Validation_Changed" />
            <TextBlock Text="至少写 4 个字。理由会留在本机，但被清掉的逐条记录不会恢复。"
                       Style="{StaticResource SecondaryTextStyle}" />
            <CheckBox x:Name="FirstResetCheck"
                      Margin="0,16,0,0"
                      Content="我知道以后不能靠重置来修改自己的戒烟记录"
                      Checked="Validation_Changed"
                      Unchecked="Validation_Changed" />
            <StackPanel x:Name="RepeatConfirmationPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock Text="请输入“认真对待自己”以继续" FontWeight="SemiBold" />
                <TextBox x:Name="RepeatConfirmationBox"
                         Margin="0,6,0,0"
                         Padding="7"
                         TextChanged="Validation_Changed" />
            </StackPanel>
            <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0" Content="取消" IsCancel="True" />
                <Button x:Name="ContinueButton"
                        Content="继续"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False"
                        Click="ContinueButton_Click" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="FinalStage" Visibility="Collapsed">
            <TextBlock Text="最后确认" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
            <TextBlock x:Name="FinalWarningText"
                       Margin="0,9,0,14"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
            <Border Padding="12"
                    Background="{DynamicResource RaisedSurfaceBrush}"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="你写下的原因" FontWeight="SemiBold" />
                    <TextBlock x:Name="ReasonSummaryText" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <CheckBox x:Name="FinalCheck"
                      Margin="0,18,0,0"
                      Content="我确认要清空这些记录；这不是一次普通撤销"
                      Checked="FinalCheck_Changed"
                      Unchecked="FinalCheck_Changed" />
            <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0" Content="返回" Click="BackButton_Click" />
                <Button Margin="0,0,8,0" Content="取消" IsCancel="True" />
                <Button x:Name="ConfirmButton"
                        Content="确认清空"
                        Style="{StaticResource DangerButtonStyle}"
                        IsEnabled="False"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
